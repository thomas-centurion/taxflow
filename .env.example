# Copy to .env and adjust. Never commit .env. Values below are for local development only.

# PostgreSQL for local development
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=taxflow
DATABASE_USER=taxflow
DATABASE_PASSWORD=taxflow_dev_only

# Backend
PORT=3002
FRONTEND_ORIGIN=http://localhost:4200
STORAGE_LOCAL_PATH=./storage
NODE_ENV=development
SEED_USER_PASSWORD=Admin123!

# JWT
# Generate a unique random secret (at least 32 bytes) for any non-local environment, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=1d

# Login rate limit per client IP + email (optional, defaults shown)
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=60

# Swagger UI at /api/docs (optional): on by default except with NODE_ENV=production; true|false overrides it
# SWAGGER_ENABLED=false

# Production options (optional; the Docker stack sets the first two itself)
# Apply pending migrations when the API starts (production images have no ts-node).
# DATABASE_MIGRATIONS_RUN=true
# Number of reverse proxies in front of the API, so the login rate limit sees the client IP.
# TRUST_PROXY=1
# Connect to PostgreSQL over TLS (managed databases usually require it). The server certificate and host name
# are always verified, against Node's public CAs unless a private CA is given (e.g. Supabase: download the
# CA from Project Settings > Database > SSL Configuration). Set at most one of the two CA variables.
# DATABASE_SSL=true
# DATABASE_SSL_CA_FILE=/etc/secrets/supabase-ca.crt
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Read-only demo mode (optional; see "Demo Mode" in the README). Comma-separated emails of existing accounts
# whose every write request (POST/PUT/PATCH/DELETE) answers 403. Use a dedicated ANALYST account.
# Case and surrounding spaces are ignored; unset or empty disables the mode. Never put passwords here.
# DEMO_READ_ONLY_EMAILS=analyst@taxflow.local

# Docker production stack (`docker compose --profile app up -d --build`)
# APP_PORT=8080
# APP_ORIGIN=http://localhost:8080

# E2E (optional): `npm --prefix backend run test:e2e` recreates <DATABASE_NAME>_test and runs a backend on this port
# E2E_DATABASE_NAME=taxflow_test
# E2E_PORT=3100
