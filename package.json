{
  "name": "taxflow",
  "version": "0.1.0",
  "private": true,
  "description": "TaxFlow local tax obligations management platform",
  "scripts": {
    "start:backend": "npm --prefix backend run start:dev",
    "start:frontend": "npm --prefix frontend start",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "db:migrate": "npm --prefix backend run migration:run",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm --prefix backend run db:setup"
  }
}
